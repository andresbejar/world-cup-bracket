# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real secrets.

# ============================================================
# Supabase (APT-6)
# Get these from: https://supabase.com/dashboard → Project → Settings → API
# ============================================================

# Project URL. Looks like: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon (public) key. Safe to ship to the browser; RLS protects rows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Server-only. Bypasses RLS.
# Used by: scoring engine, cron polling job, admin endpoints.
# NEVER expose to the browser. NEVER commit.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# api-sports.io (APT-1, verified GO)
# Direct host, NOT RapidAPI. Header: x-apisports-key.
# ============================================================

APIFOOTBALL_HOST=https://v3.football.api-sports.io
APIFOOTBALL_KEY=

# ============================================================
# GitHub Actions cron (APT-3, set as GitHub secret + variable)
# CRON_SECRET goes in repo secrets; PROD_URL goes in repo variables.
# Not used at dev time — only by the workflow + the API route it hits.
# ============================================================

# CRON_SECRET=
# PROD_URL=

# ============================================================
# Admin moderation (APT-40)
# Comma-separated auth.users.id UUIDs. Empty = no admins.
# ============================================================

# ADMIN_USER_IDS=

# ============================================================
# Prize pool tracker (APT-48)
# Tracker-only — no funds custody. Unset POOL_BUY_IN_USD to disable
# the feature. Unset a payment-method handle to hide it from the picker
# ("other" is always available as a free-text fallback).
# ============================================================

# POOL_BUY_IN_USD=20
# POOL_DEADLINE_ISO=2026-06-11T16:00:00Z
# POOL_VENMO_HANDLE=
# POOL_ZELLE_HANDLE=
# POOL_CASHAPP_HANDLE=
# POOL_PAYPAL_HANDLE=
# POOL_PAYPAL_POOL_URL=    # e.g. https://www.paypal.com/pool/XXXXX — overrides POOL_PAYPAL_HANDLE
